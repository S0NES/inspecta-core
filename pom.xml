<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.inspecta</groupId>
  <artifactId>inspecta-core</artifactId>
  <!-- SNAPSHOT: inspecta-api/inspecta-worker/inspecta-messenger consomem 1.3.x-SNAPSHOT e re-baixam a
       cada build (updatePolicy=always no <repository> de snapshots deles). Assim
       adicionar classe/método aqui NÃO exige subir versão em 4 poms. Só troque o
       número (1.4.0-SNAPSHOT, ...) num marco deliberado (quebra de API grande).
       Tradeoff: um deploy re-resolve o snapshot mais novo do Reposilite, então o
       pipeline builda inspecta-core -> deploy -> builda os consumidores, nessa ordem. -->
  <version>1.3.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>inspecta-core</name>
  <description>Inspecta - Biblioteca de dominio e acesso a banco. NINGUEM roda este projeto: e um bundle (jar) consumido por inspecta-api, inspecta-worker e inspecta-messenger.</description>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <lombok.version>1.18.46</lombok.version>
    <jacoco.version>0.8.13</jacoco.version>
    <!-- Cobertura medida em 2026-08-20: 88.46%. Ja acima da meta, entao o piso e a
         propria meta de 0.85. -->
    <jacoco.line.minimum>0.85</jacoco.line.minimum>
    <freemarker.version>2.3.34</freemarker.version>
    <spring-boot.version>3.5.0</spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Crons com lock distribuido: SchedulingConfig mora aqui, apps que rodam cron herdam. -->
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-spring</artifactId>
      <version>5.16.0</version>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-provider-jdbc-template</artifactId>
      <version>5.16.0</version>
    </dependency>

    <!-- Migrations moram neste jar (resources/db/migration). So o inspecta-api EXECUTA Flyway. -->
    <!-- Parser de template dos PDFs. Fica aqui, e nao so no inspecta-worker, porque a
         validacao de template roda no save (PdfTemplateService) e usa o parser real
         do FreeMarker para recusar sintaxe invalida antes de gravar. -->
    <dependency>
      <groupId>org.freemarker</groupId>
      <artifactId>freemarker</artifactId>
      <version>${freemarker.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Reposilite: repositório Maven interno rodando como serviço Docker no Dokploy
       (imagem dzikoysk/reposilite, ver DEPLOY_DOKPLOY.md). `mvn deploy` publica o jar
       aqui; inspecta-api/inspecta-worker/inspecta-messenger baixam de lá via <repositories> nos seus poms.
       Precisa de <server> com o mesmo id no ~/.m2/settings.xml (token gerado no
       Reposilite). Troque o host pelo domínio real assim que ele existir. -->
  <distributionManagement>
    <repository>
      <id>inspecta-reposilite</id>
      <url>https://maven.inspecta.viniciusscarabelli.tech/releases</url>
    </repository>
    <snapshotRepository>
      <id>inspecta-reposilite</id>
      <url>https://maven.inspecta.viniciusscarabelli.tech/snapshots</url>
    </snapshotRepository>
  </distributionManagement>

  <build>
    <plugins>
      <!-- Cobertura de teste. `mvn test` gera target/site/jacoco/index.html;
           `mvn verify` aplica o piso abaixo e falha o build se a cobertura cair.
           O piso e um catraca: fica no patamar atual para impedir regressao, e sobe
           deliberadamente em direcao a meta de 0.85. Nao coloque a meta aqui antes de
           a cobertura alcanca-la, ou o build nasce vermelho e o piso vira ruido. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <parameters>true</parameters>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
    </plugins>
  </build>
</project>
